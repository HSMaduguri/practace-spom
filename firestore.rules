rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Global safety net - Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global authentication & validation helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Schema Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt', 'updatedAt'])
        && data.keys().size() <= 6
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() <= 254
        && (data.get('displayName', '') is string)
        && (data.get('photoURL', '') is string)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProgressDoc(docId, data) {
      return docId in ['practice', 'flashcards', 'notes']
        && data.keys().hasAll(['userId', 'updatedAt'])
        && data.userId == request.auth.uid
        && data.updatedAt is timestamp;
    }

    // 2. User Profiles match block
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      // Let's enforce that to write, standard user is authenticated and email is verified
      allow create: if isSignedIn() && isOwner(userId) && isEmailVerified() && isValidUser(request.resource.data)
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.updatedAt == request.time;
      allow update: if isSignedIn() && isOwner(userId) && isEmailVerified() && isValidUser(request.resource.data)
                    && request.resource.data.createdAt == resource.data.createdAt
                    && request.resource.data.updatedAt == request.time;
      allow delete: if false;

      // 3. Nested Progress Collections matching: practice, flashcards, notes documents
      match /progress/{docId} {
        allow get: if isSignedIn() && isOwner(userId);
        allow create, update: if isSignedIn() && isOwner(userId) && isEmailVerified() && isValidProgressDoc(docId, request.resource.data)
                              && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
